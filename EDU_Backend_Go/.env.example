# Server / Node compatibility
PORT=4002
NODE_ENV=development
HOST=0.0.0.0
WS_PORT=4001
TERMINAL_DEBUG=false

# MySQL
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_password
DATABASE_NAME=edu_db
# 兼容旧变量名，若保留请与上面的 DATABASE_* 保持一致
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=edu_db
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=60
DATABASE_AUTO_MIGRATE=false

# Redis
REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Log
LOG_LEVEL=debug
LOG_DIR=logs

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=168h
JWT_ISSUER=edu-backend-go

# Upload
UPLOAD_ROOT=public/uploads
UPLOAD_PUBLIC_BASE=/uploads
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_FILE_MB=50

# Lab SSH
LAB_SSH_HOST=
LAB_SSH_PORT=22
LAB_SSH_USER=
LAB_SSH_PASSWORD=

# Docker / legacy runtime compatibility
DOCKER_HOST=117.50.80.138
DOCKER_PORT=2376
DOCKER_TLS=true
DOCKER_CERT_PATH=./conf
PROJECT_LAB_RUNTIME=auto

# K8S
K8S_ENABLED=true
K8S_IN_CLUSTER=false
K8S_KUBECONFIG=.kube/remote-dev.yaml
K8S_NAMESPACE=edu-backend-go-dev
K8S_RUNTIME_NAMESPACE=edu-runtime-dev
K8S_INGRESS_CLASS=nginx
K8S_LAB_IMAGE_PULL_SECRET=

# Qwen / DashScope
DASHSCOPE_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max

# OpenClaw
OPENCLAW_GATEWAY_URL=http://139.199.68.121:28199
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PASSWORD=
OPENCLAW_MODEL_ID=qwen3-max
OPENCLAW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENCLAW_API_KEY=
OPENCLAW_API_PROTOCOL=openai-completions
OPENCLAW_CONTEXT_WINDOW=200000
OPENCLAW_MAX_TOKENS=65536
OPENCLAW_CONNECT_TIMEOUT_MS=12000
OPENCLAW_REQUEST_TIMEOUT_MS=15000
OPENCLAW_RETRY_TIMES=1
OPENCLAW_CLIENT_ID=gateway-client
OPENCLAW_CLIENT_VERSION=ai-edu-agent
OPENCLAW_CLIENT_MODE=backend
OPENCLAW_CLIENT_ROLE=operator
OPENCLAW_CLIENT_SCOPES=operator.admin,operator.approvals,operator.pairing
OPENCLAW_DEVICE_IDENTITY_PATH=

# Feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=https://open.feishu.cn
FEISHU_CHAT_ID=
FEISHU_BOT_OPEN_ID=
