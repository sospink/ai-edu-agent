# 云端生产环境示例。不要在仓库提交真实密钥。
PORT=4000
NODE_ENV=production
HOST=0.0.0.0

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=change-me
DATABASE_NAME=edu_db_prod
DATABASE_AUTO_MIGRATE=false

# 兼容旧变量名，需与 DATABASE_* 保持一致。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=edu_db_prod

REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

LOG_LEVEL=info
LOG_DIR=logs

JWT_SECRET=change-me
JWT_EXPIRES_IN=168h
JWT_ISSUER=edu-backend-go

# 多个 Origin 用英文逗号分隔；不要带结尾斜杠。
SECURITY_ALLOWED_ORIGINS=http://42.240.132.79:8080,http://42.240.132.79,https://42.240.132.79

UPLOAD_ROOT=public/uploads
UPLOAD_PUBLIC_BASE=/uploads

K8S_ENABLED=true
K8S_IN_CLUSTER=false
K8S_KUBECONFIG=.kube/remote-dev.yaml
K8S_NAMESPACE=edu-backend-go-prod
K8S_RUNTIME_NAMESPACE=edu-runtime-prod
K8S_INGRESS_CLASS=nginx
K8S_LAB_IMAGE_PULL_SECRET=

DASHSCOPE_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max
