{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "autoupdate": false,
  "model": "bigmodel/glm-4-flash",

  "provider": {
    "bigmodel": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BigModel(GLM)",
      "options": {
        "baseURL": "https://open.bigmodel.cn/api/paas/v4",
        "apiKey": "{env:ZHIPUAI_API_KEY}"
      },
      "models": {
        "glm-4-flash": { "name": "GLM-4-Flash" },
        "glm-4.5-flash": { "name": "GLM-4.5-Flash" }
      }
    }
  },

  "permission": {
    "bash": "allow",
    "write": "allow",
    "edit": "allow",
    "read": "allow"
  },

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/__pycache__/**",
      "**/*.pyc"
    ]
  },

  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/root"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    }
  },

  "instructions": [
    "/workspace/AGENTS.md"
  ]
}
